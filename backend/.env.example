# Key NAMES only — never commit real values.
# The backend holds every one of these. None are exposed to the browser.

# --- LLM + TTS ---
GEMINI_API_KEY=
# --- STT (+ default LLM via openai/gpt-oss-20b) ---
GROQ_API_KEY=
# LLM provider: groq (default) or gemini. Groq won after Gemini Interactions
# from Modal us-east timed out live turns (~25s TTFT) on 2026-09-21.
# SARJY_LLM=groq
# Comma-separated Groq model chain. On 429, rotate to the next and stick.
# GROQ_LLM_MODELS=openai/gpt-oss-20b,openai/gpt-oss-120b,qwen/qwen3.8-27b

# --- Travel data (RapidAPI: Travel Buddy Visa Requirements) ---
# Free tier is 120 requests. Budgeted as a hard total — see docs/plans/TDD.md.
RAPIDAPI_KEY=
RAPIDAPI_HOST=visa-requirement.p.rapidapi.com
DEEPGRAM_API_KEY=

# --- App ---
LOG_LEVEL=info
QUOTA_RESERVE=40          # live requests held back for the demo
QUOTA_SPENT_SEED=4

# Deepgram — TTS (English). $200 signup credit, no card required.
DEEPGRAM_API_KEY=

# Parked — Arabic TTS adapter exists, not wired into get_tts().
# ORPHEUS_VOICE=noura
# ORPHEUS_TTS_MODEL=canopylabs/orpheus-arabic-saudi

# Identity hashing. Set on Modal before the first real sign-in; changing it
# later makes every PIN hash miss. Name only — never a real value here.
# SARJY_MEMORY_SALT=00a0f8d25fcf38ddfd16263f0a7ec8192e8d1ef3087f60e82938f8e14514a9f0