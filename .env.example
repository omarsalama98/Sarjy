# Key NAMES only — never commit real values.
# The backend holds every one of these. None are exposed to the browser.

# --- LLM + TTS ---
GEMINI_API_KEY=
# --- STT ---
GROQ_API_KEY=

# --- Travel data (RapidAPI: Travel Buddy Visa Requirements) ---
# Free tier is 120 requests. Budgeted as a hard total — see docs/plans/TDD.md.
RAPIDAPI_KEY=
RAPIDAPI_HOST=visa-requirement.p.rapidapi.com

# --- App ---
LOG_LEVEL=info
QUOTA_RESERVE=40          # live requests held back for the demo

# Deepgram — TTS (English). $200 signup credit, no card required.
DEEPGRAM_API_KEY=

